              "const resp = pm.response.json();",
              "pm.test('user returned', function () { pm.expect(resp.user).to.be.an('object'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Update User Profile",
      "request": {
        "method": "PUT",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "auth": {
          "type": "bearer",
          "bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman User Updated\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/users/{{userId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "users", "{{userId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('status is 200', function () { pm.response.to.have.status(200); });"]
          }
        }
      ]
    },
    {
      "name": "Create Event",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "auth": {
          "type": "bearer",
          "bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman Event\",\n  \"description\": \"Created from Postman coverage run\",\n  \"date\": \"2026-08-01\",\n  \"time\": \"18:00\",\n  \"location\": \"Online\",\n  \"category\": \"Test\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/events",
          "host": ["{{baseUrl}}"],
          "path": ["api", "events"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
              "const resp = pm.response.json();",
              "pm.collectionVariables.set('eventId', resp.data && (resp.data._id || resp.data.id));",
              "pm.test('event returned', function () { pm.expect(pm.collectionVariables.get('eventId')).to.be.a('string').and.not.empty; });"
            ]
          }
        }
      ]
    },
