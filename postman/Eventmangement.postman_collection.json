{
  "info": {
    "name": "Eventmangement - Quick API Tests",
    "_postman_id": "eventmangement-quick-tests",
    "description": "Health, Register, Login, Create Event requests. Set the collection variable `baseUrl` to point to local or deployed backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "uniqueEmail",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Register (generate unique email)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// generate a unique email for each run",
              "const ts = Date.now();",
              "const email = `pm.variables.replaceIn('test+${ts}@example.com')`;",
              "pm.collectionVariables.set('uniqueEmail', `test+${ts}@example.com`);",
              "console.log('uniqueEmail ->', pm.collectionVariables.get('uniqueEmail'));"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const resp = pm.response.json();",
              "if (resp && resp.token) {",
              "  pm.collectionVariables.set('token', resp.token);",
              "  console.log('Saved token to collection variable (token)');",
              "}",
              "pm.test('status is 201 or 200', function () {",
              "  pm.response.to.have.status(201);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Test\",\n  \"email\": \"{{uniqueEmail}}\",\n  \"password\": \"Password123\",\n  \"confirmPassword\": \"Password123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Login (use generated email)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const resp = pm.response.json();",
              "if (resp && resp.token) {",
              "  pm.collectionVariables.set('token', resp.token);",
              "  console.log('Saved token to collection variable (token)');",
              "}",
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{uniqueEmail}}\",\n  \"password\": \"Password123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create Event (protected)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// ensure token is set in header if available",
              "const t = pm.collectionVariables.get('token') || '';",
              "if (t) pm.request.headers.add({ key: 'Authorization', value: `Bearer ${t}` });"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 201', function () { pm.response.to.have.status(201); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman Created Event\",\n  \"description\": \"Created from Postman tests\",\n  \"date\": \"2026-08-01\",\n  \"time\": \"18:00\",\n  \"location\": \"Online\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/events",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "events"
          ]
        }
      },
      "response": []
    }
  ]
}
